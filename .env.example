APP_NAME=Invoice ERP
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000

# Database — existing PostgreSQL on VPS (host.docker.internal when running in Docker locally)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=invoice_erp_dev

# Resend — get your key at resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=invoices@raven-emrc.com


# Public frontend origin — used to build links emailed to external users
# (e.g. the "Seek Further Clarification" rFFesponse link)
FRONTEND_URL=http://localhost:3000

# File uploads — local path on Hostinger server
UPLOAD_DIR=/var/www/invoice_erp/uploads
MAX_UPLOAD_SIZE_MB=10

# In-app notifications
NOTIFICATIONS_PAGE_SIZE=20

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_32_char_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
