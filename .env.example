APP_NAME=Invoice ERP
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000

# Database — existing PostgreSQL on VPS (host.docker.internal when running in Docker locally)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=invoice_erp_dev

# Resend — get your key at resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=invoices@yourdomain.com

# File uploads — local path on Hostinger server
UPLOAD_DIR=/var/www/invoice_erp/uploads
MAX_UPLOAD_SIZE_MB=10

# Public origin this API is reached at, e.g. https://v0erpstaging.raven-emrc.com
# Used to build absolute file/attachment URLs so links work regardless of which
# frontend domain is consuming the API. Optional — if left unset, it's derived
# from the request's Host / X-Forwarded-Proto headers (works if nginx forwards
# them, which is the default reverse-proxy behavior).
PUBLIC_BASE_URL=

# In-app notifications
NOTIFICATIONS_PAGE_SIZE=20

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_32_char_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
